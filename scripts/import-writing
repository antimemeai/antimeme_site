#!/usr/bin/env python3
"""Import ODT essays and refresh the catalog/navigation; public HTML stays editable."""

import argparse
from html import escape
from pathlib import Path
from urllib.parse import urlsplit
from xml.etree import ElementTree as ET
from zipfile import ZipFile


ROOT = Path(__file__).resolve().parents[1]
NS = {
    "office": "urn:oasis:names:tc:opendocument:xmlns:office:1.0",
    "text": "urn:oasis:names:tc:opendocument:xmlns:text:1.0",
    "style": "urn:oasis:names:tc:opendocument:xmlns:style:1.0",
    "fo": "urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0",
    "xlink": "http://www.w3.org/1999/xlink",
}
# The reading order comes from the series introductions, not file timestamps.
ESSAYS = (
    ("intuition-in-a-data-driven-world", "intuition_in_a_data_driven_world_meta.odt",
     "/pulse/intuition-data-driven-world-patrick-beam-sxgae"),
    ("from-the-cell-to-the-atom-bomb", "from_the_cell_to_the_atom_bomb_meta.odt",
     "/pulse/from-cell-atom-bomb-patrick-beam-bxmme"),
    ("enter-the-intersubjective", "enter_the_intersubjective_meta.odt",
     "/pulse/enter-intersubjective-wilfrid-sellars-operations-theorist-beam-fg16e"),
    ("anchor-to-the-invariants", "anchor_to_the_invariants_meta.odt",
     "/pulse/anchor-invariants-patrick-beam-ppife"),
)
# Separate publications link to their original edition; local essays use the
# site's reading navigation. Dates are at the precision actually known.
PUBLICATIONS = (
    ("The Hacker Perspective",
     "https://archive.org/details/2600-volume-40-issue-1/page/n13/mode/2up",
     "Spring 2023", "2023", "2600 · Vol. 40, No. 1"),
)
ESSAY_DATE = "2023/2024"
# These articles are edited directly as HTML. Reimports retain their article
# markup while refreshing the shared page template, index, and neighbor links.
HTML_ESSAYS = (
    ("jsmntl-solo-bot-coding", "JSMNTL: Solo Bot Coding", "June 28, 2026", "2026-06-28",
     "JSMNTL: a personal practice for coding with LLMs, grounded in research, planning, testing, and review."),
)
DIAGRAM_ALT = (
    "The feedback cycle runs from regulation through externalization, niche "
    "construction, and internalization back to regulation. Regulation and "
    "niche construction together produce inventions, which natural selection "
    "turns into innovations. Innovations join system history as evolution."
)


def attr(prefix, name):
    return "{" + NS[prefix] + "}" + name


def local_link(url):
    parsed = urlsplit(url)
    if parsed.hostname in ("www.linkedin.com", "linkedin.com"):
        for slug, _, original_path in ESSAYS:
            if parsed.path.rstrip("/") == original_path:
                return f"/writing/{slug}/"
    return url


class Document:
    def __init__(self, source):
        with ZipFile(source) as archive:
            self.root = ET.fromstring(archive.read("content.xml"))
            style_roots = (ET.fromstring(archive.read("styles.xml")), self.root)
            self.styles = {
                style.get(attr("style", "name")): style
                for root in style_roots
                for style in root.findall(".//style:style", NS)
            }
        self.body = self.root.find("office:body/office:text", NS)
        self.title = next(
            "".join(el.itertext()).strip() for el in self.body
            if el.tag == attr("text", "h") and "".join(el.itertext()).strip()
        )
        self.description = next(
            "".join(el.itertext()).strip().removeprefix("tl;dr: ")
            for el in self.body if "".join(el.itertext()).strip().startswith("tl;dr:")
        )
        # Discard the publication preamble, including the released-essay list.
        # Start at the first substantive section, retaining the title separately.
        start = next(
            i for i, el in enumerate(self.body)
            if el.tag == attr("text", "h")
            and int(el.get(attr("text", "outline-level"))) > 1
            and "".join(el.itertext()).strip() not in ("", "Released Essays:")
        )
        self.body = list(self.body)[start:]

    def style_chain(self, name):
        while name in self.styles:
            yield name, self.styles[name]
            name = self.styles[name].get(attr("style", "parent-style-name"))

    def inline(self, el):
        result = escape(el.text or "")
        for child in el:
            kind = child.tag.rsplit("}", 1)[-1]
            if kind == "s":
                value = " " * int(child.get(attr("text", "c"), "1"))
            elif kind == "tab":
                value = " "
            elif kind == "line-break":
                value = "<br>"
            elif kind in ("bookmark", "bookmark-start", "bookmark-end", "soft-page-break"):
                value = ""
            elif kind == "image":
                # Retain the approved redraw instead of restoring the source bitmap.
                value = ('<a href="/writing/evolution-diagram-editorial.png">'
                         '<img src="/writing/evolution-diagram-editorial.png" '
                         f'alt="{escape(DIAGRAM_ALT, quote=True)}" '
                         'width="1086" height="1448" loading="lazy">'
                         '<span class="diagram-caption">view full size '
                         '<span aria-hidden="true">↗</span></span></a>')
            elif kind in ("a", "span", "frame"):
                value = self.inline(child)
                if kind == "a":
                    href = escape(local_link(child.get(attr("xlink", "href"))), quote=True)
                    value = f'<a href="{href}">{value}</a>'
                if kind == "span":
                    properties = {}
                    for _, style in reversed(list(self.style_chain(child.get(attr("text", "style-name"))))):
                        props = style.find("style:text-properties", NS)
                        if props is not None:
                            properties.update(props.attrib)
                    if properties.get(attr("fo", "font-weight")) == "bold":
                        value = f"<strong>{value}</strong>"
                    if properties.get(attr("fo", "font-style")) == "italic":
                        value = f"<em>{value}</em>"
            else:
                raise ValueError(f"Unrecognized inline element: {kind}")
            result += value + escape(child.tail or "")
        return result

    def block(self, el):
        kind = el.tag.rsplit("}", 1)[-1]
        if kind == "sequence-decls":
            return ""
        if kind in ("list", "list-item"):
            tag = "ul" if kind == "list" else "li"
            return f"<{tag}>\n" + "\n".join(filter(None, map(self.block, el))) + f"\n</{tag}>"
        if kind not in ("p", "h"):
            raise ValueError(f"Unrecognized block element: {kind}")
        styles = {name for name, _ in self.style_chain(el.get(attr("text", "style-name")))}
        value = self.inline(el).strip()
        if "Horizontal_20_Line" in styles:
            return "<hr>"
        if not value:
            return ""
        if el.find('.//{urn:oasis:names:tc:opendocument:xmlns:drawing:1.0}image') is not None:
            return f'<figure class="essay-diagram">{value}</figure>'
        if kind == "h":
            level = int(el.get(attr("text", "outline-level")))
            if level == 1:
                return ""  # The title is rendered once in the article header.
            if self.title == "From the Cell to the Atom Bomb":
                level = 2  # Its source uses h3 for top-level sections.
            if value == "Released Essays:":
                level = 2
            return f"<h{level}>{value}</h{level}>"
        if "Quotations" in styles:
            return f"<blockquote><p>{value}</p></blockquote>"
        return f"<p>{value}</p>"


def page(title, description, main, current="page"):
    source = (ROOT / "public/index.html").read_text()
    prefix = source.split('      <main id="main"', 1)[0]
    prefix = prefix.replace(
        'href="/" aria-current="page"', 'href="/"'
    ).replace('href="/writing/"', f'href="/writing/" aria-current="{current}"')
    start = prefix.index('    <meta name="description"')
    end = prefix.index('    <link rel="icon"', start)
    prefix = (prefix[:start] + f'    <meta name="description" content="{escape(description, quote=True)}">\n'
              + f"    <title>{escape(title)} — antimeme.ai</title>\n" + prefix[end:])
    suffix = source.split("      </main>", 1)[1]
    return prefix + main + "      </main>" + suffix


def article_page(title, description, article, index, entries):
    main = ('      <main id="main" tabindex="-1">\n        <div class="reading">\n'
            + neighbors(index, entries, "top") + '\n' + article + '\n'
            + neighbors(index, entries, "bottom") + '\n        </div>\n')
    return page(title, description, main, "location")


def neighbors(index, entries, position):
    links = []
    for offset, label, arrow in ((-1, "previous", "←"), (0, "index", ""), (1, "next", "→")):
        if offset == 0:
            links.append('            <a class="essay-index" href="/writing/">all writing</a>')
            continue
        neighbor = index + offset
        if 0 <= neighbor < len(entries):
            slug, title = entries[neighbor][:2]
            title = escape(title)
            text = (f'<span aria-hidden="true">{arrow}</span> previous' if offset < 0
                    else f'next <span aria-hidden="true">{arrow}</span>')
            links.append(
                f'            <a class="essay-{label}" href="/writing/{slug}/" '
                f'rel="{"prev" if offset < 0 else "next"}" '
                f'aria-label="{label.capitalize()} essay: {title}">{text}</a>'
            )
    return (f'          <nav class="site-nav essay-nav" aria-label="Essay navigation ({position})">\n'
            + "\n".join(links) + "\n          </nav>")


def listing_item(title, href, date, year=None, publication=None):
    if year:
        date_html = f'<time class="writing-date" datetime="{escape(year, quote=True)}">{escape(date)}</time>'
    else:
        date_html = (f'<span class="writing-date" aria-label="Approximate writing date: '
                     f'{escape(date, quote=True)}">{escape(date)}</span>')
    note = (f'                <span class="writing-publication">{escape(publication)}</span>\n'
            if publication else "")
    return (f'            <li><a href="{escape(href, quote=True)}">\n'
            f'                <span class="writing-title">{escape(title)}</span>\n'
            f'                {date_html}\n' + note + '            </a></li>')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("source_directory", type=Path)
    args = parser.parse_args()
    documents = [Document(args.source_directory / name) for _, name, _ in ESSAYS]
    destination = ROOT / "public/writing"
    destination.mkdir(exist_ok=True)
    entries = [(slug, doc.title, ESSAY_DATE, None, doc.description)
               for (slug, _, _), doc in zip(ESSAYS, documents)] + list(HTML_ESSAYS)
    articles = []
    for doc in documents:
        body = "\n".join("              " + block for el in doc.body if (block := doc.block(el)))
        articles.append('          <article>\n'
                        + f'            <header class="essay-heading"><h1>{escape(doc.title)}</h1></header>\n'
                        + '            <div class="essay-body">\n' + body
                        + '\n            </div>\n          </article>')
    for slug, _, _, _, _ in HTML_ESSAYS:
        source = (destination / slug / "index.html").read_text()
        start = source.index('          <article>')
        end = source.index('          </article>', start) + len('          </article>')
        articles.append(source[start:end])
    items = "\n".join(
        [listing_item(*publication) for publication in PUBLICATIONS]
        + [listing_item(title, f"/writing/{slug}/", date, year)
           for slug, title, date, year, _ in entries]
    )
    listing = ('      <main id="main" class="writing-main" tabindex="-1">\n'
               '        <section class="intro" aria-labelledby="intro-heading">\n'
               '          <h1 id="intro-heading">writing.</h1>\n        </section>\n'
               '        <ul class="writing-list" aria-label="Writings">\n'
               + items + '\n        </ul>\n')
    (destination / "index.html").write_text(page("Writing", "Essays by Patrick Beam.", listing))
    for i, ((slug, title, _, _, description), article) in enumerate(zip(entries, articles)):
        target = destination / slug
        target.mkdir(exist_ok=True)
        (target / "index.html").write_text(article_page(title, description, article, i, entries))
    print(f"Updated {len(entries)} local essays and the writing index.")


if __name__ == "__main__":
    main()
